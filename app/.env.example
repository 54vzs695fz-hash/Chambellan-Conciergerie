# Public URL of the deployed app (required for PDF export on Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Local development (default) ---
# Leave DATABASE_URL unset to use SQLite at app/data/chambellan.db

# --- Production (Vercel / Neon) ---
# Persistent Postgres — required on Vercel so data survives redeploys.
# Works with Vercel Postgres, Neon, or any Postgres provider.
#
# Vercel Postgres: Project → Storage → Postgres → copy POSTGRES_URL or DATABASE_URL
# Neon: https://neon.tech → create project → copy connection string
#
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
