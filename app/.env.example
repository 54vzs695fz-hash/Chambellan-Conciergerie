# Public URL of the deployed app (required for PDF export on Vercel and WebAuthn)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (required for local dev and production)
# Vercel Prisma Postgres: Project → Storage → copy DATABASE_URL
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication (required in production)
# Generate with: openssl rand -base64 48
# AUTH_SECRET=

# Internal accounts (only Matthieu and Yanis — no public sign-up)
# matthieu@chambellan-conciergerie.fr
# yanis@chambellan-conciergerie.fr
# Create or reset passwords locally / on deploy:
#   cd app && npm run seed:auth
# AUTH_MATTHIEU_PASSWORD=
# AUTH_YANIS_PASSWORD=

# WebAuthn relying party ID (hostname only, no protocol)
# Local: localhost | Production: chambellan-conciergerie.vercel.app
# AUTH_WEBAUTHN_RP_ID=localhost
