{
  "name": "chambellan-concierge",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next",
    "dev:clean": "npm run clean && npm run dev",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:import-sqlite": "node scripts/migrate-sqlite-to-prisma.mjs",
    "test:mobile": "node scripts/test-mobile-flows.mjs",
    "test:website-import": "node scripts/test-website-import.mjs",
    "seed:library-v3": "node scripts/seed-library-v3.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@react-pdf/renderer": "^4.3.0",
    "@sparticuz/chromium": "^147.0.0",
    "dotenv": "^16.5.0",
    "next": "^15.3.3",
    "pg": "^8.16.0",
    "puppeteer-core": "^25.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "better-sqlite3": "^11.8.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "prisma": "^7.8.0",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
