generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id          Int      @id @default(autoincrement())
  full_name   String   @default("")
  phone       String   @default("")
  whatsapp    String   @default("")
  email       String   @default("")
  nationality String   @default("")
  notes       String   @default("")
  preferences String   @default("")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  trips       Trip[]

  @@map("clients")
}

model Trip {
  id                       Int       @id @default(autoincrement())
  client_id                Int?
  client_name              String    @default("")
  destination              String    @default("")
  multi_destination        Boolean   @default(false)
  destinations             Json      @default("[]")
  destination_region       String    @default("")
  arrival_date             String    @default("")
  departure_date           String    @default("")
  hotel                    String    @default("")
  villa                    String    @default("")
  driver                   String    @default("")
  butler                   String    @default("")
  security                 String    @default("")
  notes                    String    @default("")
  driver_name              String    @default("")
  driver_phone             String    @default("")
  butler_name              String    @default("")
  butler_phone             String    @default("")
  security_contact       String    @default("")
  emergency_contact        String    @default("")
  yacht                    String    @default("")
  jet                      String    @default("")
  restaurant_reservations  String    @default("")
  club_reservations        String    @default("")
  host_name                String    @default("Matthieu Dubourg")
  host_phone               String    @default("+1 332 733 9543")
  host_contact             String    @default("")
  tailored_for             String    @default("")
  follow_up_status         String    @default("follow_up")
  payment_status           String    @default("pending")
  total_amount             String    @default("")
  amount_received          String    @default("")
  payment_method           String    @default("")
  payment_notes            String    @default("")
  event_booking            String    @default("")
  event_venue              String    @default("")
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  client                   Client?   @relation(fields: [client_id], references: [id], onDelete: SetNull)
  days                     TripDay[]
  checklist_items          TripChecklistItem[]

  @@index([client_id], map: "idx_trips_client")
  @@map("trips")
}

model TripChecklistItem {
  id            Int    @id @default(autoincrement())
  trip_id       Int
  category      String
  title         String @default("")
  status        String @default("todo")
  notes         String @default("")
  due_date      String @default("")
  reminder_date String @default("")
  sort_order    Int    @default(0)
  trip          Trip   @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id], map: "idx_checklist_trip")
  @@map("trip_checklist_items")
}

model TripDay {
  id         Int        @id @default(autoincrement())
  trip_id    Int
  date       String
  sections              String     @default("[]")
  destination_override  String     @default("")
  trip                  Trip       @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([trip_id, date])
  @@index([trip_id], map: "idx_trip_days_trip")
  @@map("trip_days")
}

model Activity {
  id             Int     @id @default(autoincrement())
  trip_day_id    Int
  period         String
  activity_type  String  @default("activity")
  time           String  @default("")
  title          String  @default("")
  details        String  @default("")
  status         String  @default("confirmed")
  booking_status String  @default("to_request")
  assigned_to    String  @default("")
  booking_notes      String  @default("")
  sort_order         Int     @default(0)
  establishment_city String  @default("")
  beach_sunbeds      Boolean @default(false)
  beach_sunbeds_time String  @default("")
  beach_lunch        Boolean @default(false)
  beach_lunch_time   String  @default("")
  beach_sunbeds_status String @default("to_request")
  beach_lunch_status   String @default("to_request")
  trip_day           TripDay @relation(fields: [trip_day_id], references: [id], onDelete: Cascade)

  @@index([trip_day_id], map: "idx_activities_day")
  @@map("activities")
}

model Establishment {
  id             Int      @id @default(autoincrement())
  name           String
  category       String
  city           String   @default("")
  address        String   @default("")
  contact_name   String   @default("")
  phone          String   @default("")
  whatsapp       String   @default("")
  email          String   @default("")
  website        String   @default("")
  instagram      String   @default("")
  notes          String   @default("")
  price_level    String   @default("")
  tags           String   @default("")
  internal_notes String   @default("")
  is_favorite    Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([category], map: "idx_establishments_category")
  @@index([city], map: "idx_establishments_city")
  @@index([name], map: "idx_establishments_name")
  @@map("establishments")
}

model ConciergeEvent {
  id             Int          @id @default(autoincrement())
  name           String
  category       String
  destination    String
  start_date     String       @default("")
  end_date       String       @default("")
  contact_name   String       @default("")
  phone          String       @default("")
  whatsapp       String       @default("")
  email          String       @default("")
  website        String       @default("")
  notes          String       @default("")
  internal_notes String       @default("")
  is_favorite    Boolean      @default(false)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  venues         EventVenue[]

  @@index([category], map: "idx_events_category")
  @@index([destination], map: "idx_events_destination")
  @@index([name], map: "idx_events_name")
  @@map("concierge_events")
}

model EventVenue {
  id             Int             @id @default(autoincrement())
  event_id       Int?
  name           String
  destination    String
  contact_name   String          @default("")
  phone          String          @default("")
  whatsapp       String          @default("")
  email          String          @default("")
  website        String          @default("")
  notes          String          @default("")
  internal_notes String          @default("")
  is_favorite    Boolean         @default(false)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  event          ConciergeEvent? @relation(fields: [event_id], references: [id], onDelete: SetNull)

  @@index([event_id], map: "idx_event_venues_event")
  @@index([destination], map: "idx_event_venues_destination")
  @@index([name], map: "idx_event_venues_name")
  @@map("event_venues")
}

model AppUser {
  id            Int                  @id @default(autoincrement())
  email         String               @unique
  name          String
  role          String               @default("admin")
  password_hash String
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt
  credentials   WebAuthnCredential[]

  @@map("app_users")
}

model WebAuthnCredential {
  id              Int      @id @default(autoincrement())
  user_id         Int
  credential_id   String   @unique
  public_key      Bytes
  counter         BigInt   @default(0)
  device_type     String   @default("")
  backed_up       Boolean  @default(false)
  transports      String   @default("")
  created_at      DateTime @default(now())
  user            AppUser  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_webauthn_user")
  @@map("webauthn_credentials")
}
